%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: c6d48d159b0712b4db6826112d53ec15, type: 3}
  m_Name: Tutorial_SO
  m_EditorClassIdentifier: Assembly-CSharp::SniperStrategyGame.Tutorial.Tutorial_SO
  tutorialGroupsList:
  - tutorialGroupName: Gun Fundamentals
    tutorialGoalInfo: Learn the basics of aiming, scoping, and shooting
    tutorialStepsList:
    - tutorialAction: 1
      tutorialActionText: SCOPE IN
      requiredEnemySpawnDataList: []
      instruction: Press to scope in to aim down your sights
      instructionButtonMapSprite: {fileID: 10905, guid: 0000000000000000f000000000000000, type: 0}
      instructionContainerSize: 384
      showOverlay: 1
      allowShooting: 0
    - tutorialAction: 2
      tutorialActionText: SCOPE OUT
      requiredEnemySpawnDataList: []
      instruction: Press to scope out to return to your normal view
      instructionButtonMapSprite: {fileID: 10905, guid: 0000000000000000f000000000000000, type: 0}
      instructionContainerSize: 430
      showOverlay: 1
      allowShooting: 0
    - tutorialAction: 3
      tutorialActionText: SHOOT
      requiredEnemySpawnDataList: []
      instruction: Press to fire your gun at the Target after Scoped In
      instructionButtonMapSprite: {fileID: 10905, guid: 0000000000000000f000000000000000, type: 0}
      instructionContainerSize: 450
      showOverlay: 1
      allowShooting: 1
  - tutorialGroupName: Enemy Types
    tutorialGoalInfo: Learn to identify & eliminate different types of enemies
    tutorialStepsList:
    - tutorialAction: 4
      tutorialActionText: GUARD ENEMY
      requiredEnemySpawnDataList:
      - enemyType: 0
        spawnPointIndex: 0
      instruction: Aim at the Guard enemy and eliminate it.
      instructionButtonMapSprite: {fileID: 0}
      instructionContainerSize: 332
      showOverlay: 0
      allowShooting: 1
    - tutorialAction: 5
      tutorialActionText: PATROL ENEMY
      requiredEnemySpawnDataList:
      - enemyType: 1
        spawnPointIndex: 1
      instruction: Aim at the Patrol enemy and eliminate it.
      instructionButtonMapSprite: {fileID: 0}
      instructionContainerSize: 332
      showOverlay: 0
      allowShooting: 1
    - tutorialAction: 6
      tutorialActionText: SHIELD ENEMY
      requiredEnemySpawnDataList:
      - enemyType: 2
        spawnPointIndex: 0
      instruction: Aim at the Shield enemy and eliminate it.
      instructionButtonMapSprite: {fileID: 0}
      instructionContainerSize: 332
      showOverlay: 0
      allowShooting: 1
  - tutorialGroupName: Teleport Ability
    tutorialGoalInfo: Learn to teleport after shooting to move around the map
    tutorialStepsList:
    - tutorialAction: 7
      tutorialActionText: TELEPORT ABILITY
      requiredEnemySpawnDataList:
      - enemyType: 0
        spawnPointIndex: 0
      - enemyType: 1
        spawnPointIndex: 1
      - enemyType: 2
        spawnPointIndex: 2
      - enemyType: 2
        spawnPointIndex: 3
      instruction: Teleport around the map & eliminate all enemies
      instructionButtonMapSprite: {fileID: 0}
      instructionContainerSize: 350
      showOverlay: 0
      allowShooting: 1
